" value="localStorage&lt;br&gt;&lt;i&gt;navigateur&lt;/i&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1750" y="90" width="160" height="1784" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Diagramme de séquence — clic sur « Se connecter »&lt;/b&gt;&lt;br&gt;Guitar Practice Cloud · TP1 Mission 0 · &lt;font color="#666666"&gt;flux réel du code : login-page.ts → auth.service.ts → intercepteurs → app.js → MongoDB&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="55" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;1.&lt;/b&gt; Saisit email + mot de passe&lt;br&gt;puis clique « Se connecter »" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="190" as="sourcePoint"/><mxPoint x="310.0" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="316.0" y="242" as="sourcePoint"/><mxPoint x="316.0" y="266" as="targetPoint"/><Array as="points"><mxPoint x="346.0" y="242"/><mxPoint x="346.0" y="266"/></Array></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;2.&lt;/b&gt; &lt;code&gt;(ngSubmit)&lt;/code&gt; → &lt;code&gt;submit()&lt;/code&gt;&lt;br&gt;&lt;code&gt;values = form.getRawValue()&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="352.0" y="232" width="300" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3.&lt;/b&gt; &lt;code&gt;login(email, password)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="304" as="sourcePoint"/><mxPoint x="500.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;4.&lt;/b&gt; &lt;code&gt;http.post('/api/auth/login', {email, password})&lt;/code&gt;&lt;br&gt;&lt;code&gt;.pipe(tap(storeAuthentication))&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="350" as="sourcePoint"/><mxPoint x="690.0" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;5.&lt;/b&gt; Observable « froid » (rien n'est encore envoyé)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="404" as="sourcePoint"/><mxPoint x="310.0" y="404" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;6.&lt;/b&gt; &lt;code&gt;.subscribe({ next, error })&lt;/code&gt; → déclenche l'envoi" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="450" as="sourcePoint"/><mxPoint x="690.0" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;7.&lt;/b&gt; &lt;code&gt;authInterceptor(request, next)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690.0" y="496" as="sourcePoint"/><mxPoint x="880.0" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="886.0" y="542" as="sourcePoint"/><mxPoint x="886.0" y="566" as="targetPoint"/><Array as="points"><mxPoint x="916.0" y="542"/><mxPoint x="916.0" y="566"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;8.&lt;/b&gt; &lt;code&gt;auth.token()&lt;/code&gt; est &lt;code&gt;null&lt;/code&gt;&lt;br&gt;→ requête &lt;b&gt;inchangée&lt;/b&gt; (route publique, pas de Bearer)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="922.0" y="532" width="300" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;9.&lt;/b&gt; &lt;code&gt;next(request)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880.0" y="604" as="sourcePoint"/><mxPoint x="1070.0" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;10.&lt;/b&gt; POST /api/auth/login (JSON) vers :4200" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="650" as="sourcePoint"/><mxPoint x="1260.0" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;11.&lt;/b&gt; relayé vers http://localhost:3000" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="696" as="sourcePoint"/><mxPoint x="1450.0" y="696" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1456.0" y="742" as="sourcePoint"/><mxPoint x="1456.0" y="766" as="targetPoint"/><Array as="points"><mxPoint x="1486.0" y="742"/><mxPoint x="1486.0" y="766"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;12.&lt;/b&gt; &lt;code&gt;express.json()&lt;/code&gt; → &lt;code&gt;req.body&lt;/code&gt;&lt;br&gt;&lt;code&gt;email = String(email).toLowerCase()&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1492.0" y="732" width="300" height="44" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;13.&lt;/b&gt; &lt;code&gt;User.findOne({ email }).select('+passwordHash')&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450.0" y="804" as="sourcePoint"/><mxPoint x="1640.0" y="804" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;14.&lt;/b&gt; document User (ou &lt;code&gt;null&lt;/code&gt;)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640.0" y="850" as="sourcePoint"/><mxPoint x="1450.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1456.0" y="918" as="sourcePoint"/><mxPoint x="1456.0" y="942" as="targetPoint"/><Array as="points"><mxPoint x="1486.0" y="918"/><mxPoint x="1486.0" y="942"/></Array></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;15.&lt;/b&gt; &lt;code&gt;user.verifyPassword()&lt;/code&gt; → &lt;code&gt;bcrypt.compare()&lt;/code&gt; = true&lt;br&gt;&lt;code&gt;token(user)&lt;/code&gt; → &lt;code&gt;jwt.sign({sub, email}, SECRET, {expiresIn:'2h'})&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1492.0" y="908" width="340" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;16.&lt;/b&gt; &lt;b&gt;200&lt;/b&gt; &lt;code&gt;{ token, user: user.toPublic() }&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450.0" y="984" as="sourcePoint"/><mxPoint x="1260.0" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;17.&lt;/b&gt; réponse 200" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="1030" as="sourcePoint"/><mxPoint x="1070.0" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;18.&lt;/b&gt; pas d'erreur → remonte via authInterceptor, sans modification" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="1076" as="sourcePoint"/><mxPoint x="690.0" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;19.&lt;/b&gt; &lt;code&gt;AuthResponse { token, user }&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690.0" y="1122" as="sourcePoint"/><mxPoint x="500.0" y="1122" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="1168" as="sourcePoint"/><mxPoint x="506.0" y="1192" as="targetPoint"/><Array as="points"><mxPoint x="536.0" y="1168"/><mxPoint x="536.0" y="1192"/></Array></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;20.&lt;/b&gt; &lt;code&gt;tap&lt;/code&gt; → &lt;code&gt;storeAuthentication(response)&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="542.0" y="1158" width="300" height="44" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;21.&lt;/b&gt; &lt;code&gt;localStorage.setItem('gpc_token', token)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="1218" as="sourcePoint"/><mxPoint x="1830.0" y="1218" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.0" y="1264" as="sourcePoint"/><mxPoint x="506.0" y="1288" as="targetPoint"/><Array as="points"><mxPoint x="536.0" y="1264"/><mxPoint x="536.0" y="1288"/></Array></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;22.&lt;/b&gt; Signals : &lt;code&gt;token.set(token)&lt;/code&gt; ; &lt;code&gt;currentUser.set(user)&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;isAuthenticated()&lt;/code&gt; = true : l'en-tête se met à jour" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="542.0" y="1254" width="330" height="44" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;23.&lt;/b&gt; &lt;code&gt;next(response)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="1326" as="sourcePoint"/><mxPoint x="310.0" y="1326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="316.0" y="1372" as="sourcePoint"/><mxPoint x="316.0" y="1396" as="targetPoint"/><Array as="points"><mxPoint x="346.0" y="1372"/><mxPoint x="346.0" y="1396"/></Array></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;24.&lt;/b&gt; &lt;code&gt;router.navigateByUrl('/tracks')&lt;/code&gt;&lt;br&gt;&lt;code&gt;authGuard&lt;/code&gt; laisse passer (token présent)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="352.0" y="1362" width="300" height="44" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;25.&lt;/b&gt; page « Backing tracks » affichée" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="1434" as="sourcePoint"/><mxPoint x="120.0" y="1434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value='&lt;b&gt;26.&lt;/b&gt; &lt;b&gt;401&lt;/b&gt; &lt;code&gt;{ message: "Identifiants incorrects" }&lt;/code&gt;' style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450.0" y="1502" as="sourcePoint"/><mxPoint x="1260.0" y="1502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="&lt;b&gt;27.&lt;/b&gt; réponse 401" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260.0" y="1548" as="sourcePoint"/><mxPoint x="1070.0" y="1548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1076.0" y="1594" as="sourcePoint"/><mxPoint x="1076.0" y="1618" as="targetPoint"/><Array as="points"><mxPoint x="1106.0" y="1594"/><mxPoint x="1106.0" y="1618"/></Array></mxGeometry></mxCell><mxCell id="c47" value="&lt;b&gt;28.&lt;/b&gt; &lt;code&gt;catchError&lt;/code&gt; : 401 &lt;b&gt;mais&lt;/b&gt; URL &lt;code&gt;/api/auth/…&lt;/code&gt;&lt;br&gt;→ pas de logout ni de redirection, &lt;code&gt;throwError(error)&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1112.0" y="1584" width="320" height="44" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;29.&lt;/b&gt; &lt;code&gt;HttpErrorResponse&lt;/code&gt; 401 remonte via HttpClient (le &lt;code&gt;tap&lt;/code&gt; n'est pas exécuté : rien n'est stocké)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="1656" as="sourcePoint"/><mxPoint x="500.0" y="1656" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="&lt;b&gt;30.&lt;/b&gt; &lt;code&gt;error(error)&lt;/code&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="1702" as="sourcePoint"/><mxPoint x="310.0" y="1702" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="316.0" y="1748" as="sourcePoint"/><mxPoint x="316.0" y="1772" as="targetPoint"/><Array as="points"><mxPoint x="346.0" y="1748"/><mxPoint x="346.0" y="1772"/></Array></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;31.&lt;/b&gt; &lt;code&gt;this.error.set(error.error?.message)&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="352.0" y="1738" width="300" height="44" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;32.&lt;/b&gt; « Identifiants incorrects » affiché sous le formulaire" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310.0" y="1798" as="sourcePoint"/><mxPoint x="120.0" y="1798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;alt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=24;fillColor=none;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="30" y="888" width="1930.0" height="946" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;[email trouvé ET mot de passe correct]&lt;/b&gt;" style="text;html=1;align=left;fontSize=11;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="88" y="890" width="320" height="20" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="1474" as="sourcePoint"/><mxPoint x="1960.0" y="1474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;[sinon : utilisateur inconnu ou mot de passe faux]&lt;/b&gt;" style="text;html=1;align=left;fontSize=11;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="88" y="1476" width="380" height="20" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;→ trait plein : appel / requête · ⇢ pointillés : retour / réponse · boucle : traitement interne&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; frontend Angular   &lt;font color=&quot;#666666&quot;&gt;■&lt;/font&gt; navigateur / outil de dev   &lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; backend Express   &lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; base de données&lt;br&gt;Les deux intercepteurs sont enregistrés dans &lt;code&gt;main.ts&lt;/code&gt; : &lt;code&gt;withInterceptors([authInterceptor, unauthorizedInterceptor])&lt;/code&gt;. Le mot de passe n'est jamais stocké ni journalisé ; le JWT n'est jamais affiché." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fafafa;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1894" width="1100" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>